# Copy these names into Coolify's Environment Variables section.
# Generate unique, strong values before deploying; do not commit real secrets.
MARIADB_ROOT_PASSWORD=replace-with-a-strong-root-password
WORDPRESS_DB_PASSWORD=replace-with-a-different-strong-database-password

# Optional. These defaults are used when the variables are omitted.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
